# Copy to .env and edit. `docker compose` reads .env automatically.
#   cp .env.example .env
#   nano .env            # set a real ADMIN_PASSWORD (and a real SESSION_SECRET)
#   docker compose up -d

# REQUIRED before you send any participant link. The app prints a warning in the UI and in the
# container log while this is unset or equal to "admin".
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# REQUIRED for stable sessions. Signs the short-lived admin bearer tokens. If unset it is derived
# from ADMIN_PASSWORD with PBKDF2, which means every password change invalidates live sessions.
# Generate one:  openssl rand -hex 32
SESSION_SECRET=

# Set to 1 ONLY when a reverse proxy you own (Traefik, Caddy, nginx) terminates TLS in front.
# It is what makes X-Forwarded-For trusted for rate limiting and for the access log. Leaving it
# on while the app is directly exposed lets clients spoof their address and dodge limits.
TRUST_PROXY=0

# --- optional tuning (defaults shown) -----------------------------------------------------------
# LOGIN_RATE_LIMIT=10           # login attempts per minute per client
# LOGIN_LOCKOUT_THRESHOLD=5     # failed logins in that minute before a temporary lockout
# LOGIN_LOCKOUT_SECONDS=300     # how long the lockout lasts
# DRAW_RATE_LIMIT=120           # participant-link lookups per minute per client
# API_RATE_LIMIT=300            # everything else per minute per client
# MAX_BODY_BYTES=16384          # request body cap -> 413
# SESSION_TTL_SECONDS=43200     # admin session token lifetime (12 h)
